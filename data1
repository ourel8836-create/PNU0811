                                한양대 정시 70% Cut 백분위인 <strong class="text-emerald-600 dark:text-emerald-400">93.25</strong> 와 부산대 수시 내신 평균 <strong class="text-blue-600 dark:text-blue-400">2.78</strong> 은 수험생이 선택해야 할 명확한 갈림길입니다. 모의고사 성적이 93.25를 상회한다면 수도권 정시에 주력하되, 이에 미치지 못한다면 부산대 등 거점 국립대의 수시 지표 하락 구간을 노리는 것이 합리적인 전략입니다.
                            </p>
                        </div>
                    </div>
                    <span class="shrink-0 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">
                        수시/정시 나침반
                    </span>
                </div>
            </div>
        </section>

        <!-- SECTION 7: Interactive Admissions Strategy Calculator Widget -->
        <section id="simulator" class="bg-gradient-to-br from-blue-900 to-indigo-900 text-white rounded-2xl p-6 sm:p-8 shadow-lg no-print">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md text-amber-400 flex items-center justify-center font-bold text-xl border border-white/20">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold">국어교육과 지원 전략 자가 진단 시뮬레이터</h2>
                    <p class="text-xs sm:text-sm text-slate-300">자신의 내신 및 수능 모의고사 백분위를 입력하여 맞춤 분석을 확인하세요.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-white/5 backdrop-blur-md p-5 rounded-xl border border-white/10 mb-6">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-2">학생부 내신 등급 (교과 평균)</label>
                    <input type="number" id="user-gpa" min="1.0" max="9.0" step="0.01" value="2.50" class="w-full bg-slate-800 text-white border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-2">수능 모의고사 예상 백분위 (국/수/탐)</label>
                    <input type="number" id="user-csat" min="0" max="100" step="0.1" value="90.5" class="w-full bg-slate-800 text-white border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-2">학생부 세특/비교과 경쟁률 평가</label>
                    <select id="user-record" class="w-full bg-slate-800 text-white border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
                        <option value="high">최상 (특목/자사고 및 탐구 세특 우수)</option>
                        <option value="mid" selected>보통 (일반고 무난한 세특)</option>
                        <option value="low">미흡 (교과 위주 관리)</option>
                    </select>
                </div>
            </div>

            <button onclick="calculateStrategy()" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-sm rounded-xl transition shadow-md flex items-center justify-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles"></i> 지원 가능성 및 전략 분석 실행
            </button>

            <!-- Diagnosis Output Box -->
            <div id="diagnosis-result" class="mt-6 p-5 rounded-xl bg-white/10 border border-white/20 text-sm hidden">
                <!-- JavaScript Output goes here -->
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 px-4 border-t border-slate-800 text-center text-xs no-print">
        <div class="max-w-7xl mx-auto space-y-2">
            <p class="font-medium text-slate-300">부산대학교 중심 국어교육과 입시 지표 분석 보고서</p>
            <p>본 데이터는 2022~2024학년도 대학별 수시/정시 공식 공개 자료 및 입시 분석 데이터를 기반으로 작성되었습니다.</p>
            <p class="text-slate-600">© 2026 Admissions Strategy Research Group. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Dark Mode Toggle Logic
        function toggleDarkMode() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('theme-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                themeIcon.classList.replace('fa-sun', 'fa-moon');
            } else {
                html.classList.add('dark');
                themeIcon.classList.replace('fa-moon', 'fa-sun');
            }
        }

        // Initialize Charts on Window Load
        window.onload = function() {
            initPNUChart();
            initHanyangChart();
        };

        // 1. PNU Dual Axis Chart (Competition Rate vs Inner Grade)
        function initPNUChart() {
            const ctx = document.getElementById('pnuChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['2023학년도', '2024학년도'],
                    datasets: [
                        {
                            label: '경쟁률 (:1)',
                            data: [24.0, 5.9],
                            backgroundColor: 'rgba(239, 68, 68, 0.7)',
                            borderColor: 'rgb(239, 68, 68)',
                            borderWidth: 1,
                            yAxisID: 'y'
                        },
                        {
                            label: '최종 등록자 내신 평균(등급)',
                            data: [2.20, 2.78],
                            type: 'line',
                            borderColor: 'rgb(245, 158, 11)',
                            backgroundColor: 'rgb(245, 158, 11)',
                            pointRadius: 6,
                            pointHoverRadius: 8,
                            borderWidth: 3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: '경쟁률 (:1)'
                            },
                            suggestedMax: 30,
                            grid: {
                                color: 'rgba(150, 150, 150, 0.1)'
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            reverse: true, // Grade 1 is better than Grade 9
                            title: {
                                display: true,
                                text: '내신 평균 (등급, 역축)'
                            },
                            suggestedMin: 1.5,
                            suggestedMax: 3.5,
                            grid: {
                                drawOnChartArea: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }

        // 2. Hanyang University Multi-Year Chart
        function initHanyangChart() {
            const ctx = document.getElementById('hanyangChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['2022학년도', '2023학년도', '2024학년도'],
                    datasets: [
                        {
                            label: '교과(지역균형) 경쟁률',
                            data: [11.0, 5.0, 6.7],
                            borderColor: 'rgb(59, 130, 246)',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            tension: 0.2,
                            fill: true,
                            borderWidth: 2
                        },
                        {
                            label: '학종(일반) 경쟁률',
                            data: [22.2, 13.6, 15.6],
                            borderColor: 'rgb(168, 85, 247)',
                            backgroundColor: 'rgba(168, 85, 247, 0.1)',
                            tension: 0.2,
                            fill: true,
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: '경쟁률 (:1)'
                            },
                            grid: {
                                color: 'rgba(150, 150, 150, 0.1)'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12
                            }
                        }
                    }
                }
            });
        }

        // Strategy Simulator Function
        function calculateStrategy() {
            const gpa = parseFloat(document.getElementById('user-gpa').value);
            const csat = parseFloat(document.getElementById('user-csat').value);
            const record = document.getElementById('user-record').value;
            const output = document.getElementById('diagnosis-result');

            if (isNaN(gpa) || isNaN(csat)) {
                output.classList.remove('hidden');
                output.innerHTML = `<p class="text-red-300 font-bold"><i class="fa-solid fa-triangle-exclamation mr-1"></i> 유효한 내신 및 백분위 점수를 입력해 주세요.</p>`;
                return;
            }

            let pnuStrategy = '';
            let hanyangStrategy = '';
            let recommendation = '';

            // PNU Analysis
            if (gpa <= 2.5) {
                pnuStrategy = `<span class="text-emerald-400 font-bold">부산대 수시 매우 유망</span> (전년도 평균 2.78 대비 안정권)`;
            } else if (gpa <= 3.1) {
                pnuStrategy = `<span class="text-amber-300 font-bold">부산대 수시 전략적 소신 지원</span> (경쟁률 기피 반작용 구간 활용 가능)`;
            } else {
                pnuStrategy = `<span class="text-red-300 font-bold">부산대 수시 신중 필요</span> (수능 최저 및 타지역 거점대 병행 고려)`;
            }

            // Hanyang Analysis
            if (csat >= 93.25) {
                hanyangStrategy = `<span class="text-emerald-400 font-bold">수도권 상위 정시(한양대 등) 우선</span> (70% Cut 93.25 상회)`;
            } else if (record === 'high' && gpa <= 3.1) {
                hanyangStrategy = `<span class="text-amber-300 font-bold">한양대 학종 정성평가 상향 카드로 유효</span> (학종 평균 3.06과 부합)`;
            } else {
                hanyangStrategy = `<span class="text-slate-300 font-bold">수도권 정시 보합권 / 수시 교과 부담</span>`;
            }

            // Overall Recommendation
            if (csat >= 92.0) {
                recommendation = "모의고사 성적이 우수하므로, 수시에서는 부산대를 '안정/적정' 카드로 확보하고 수도권 주요 대학 정시를 적극적으로 노리는 상향 전략을 권장합니다.";
            } else if (gpa <= 2.8) {
                recommendation = "부산대 수시 국어교육과 지원 시 전년도 입결 하락(2.78)에 따른 금년도 경쟁률 재반등 가능성을 염두에 두고, 수능 최저학력기준 충족에 만전을 기하십시오.";
            } else {
                recommendation = "전년도 경쟁률 폭등 후 급락했던 거점 대학 학과의 '역발상 상향 지원' 전략을 적극 검토하되, 학생부 정성 평가 요소의 강점을 점검할 필요가 있습니다.";
            }

            output.classList.remove('hidden');
            output.innerHTML = `
                <h3 class="text-base font-bold text-amber-400 mb-3 border-b border-white/10 pb-2">
                    <i class="fa-solid fa-chart-pie mr-1"></i> 입력 데이터 기반 전략 진단 결과
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div class="bg-black/20 p-3 rounded-lg border border-white/10">
                        <span class="text-xs text-slate-300 block">부산대 국어교육과 분석</span>
                        <p class="text-sm mt-1">${pnuStrategy}</p>
                    </div>
                    <div class="bg-black/20 p-3 rounded-lg border border-white/10">
                        <span class="text-xs text-slate-300 block">수도권(한양대 등) 타겟 분석</span>
                        <p class="text-sm mt-1">${hanyangStrategy}</p>
                    </div>
                </div>
                <div class="p-3 bg-blue-500/20 rounded-lg border border-blue-400/30 text-xs sm:text-sm text-slate-200">
                    <strong><i class="fa-solid fa-quote-left text-amber-400 mr-1"></i> 전략 총평:</strong> ${recommendation}
                </div>
            `;
        }
    </script>
</body>
</html>
